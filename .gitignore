# shipreel workspaces (if you run it inside the repo)
output/
temp/
shipreel.config.json

# local agent installs (the vendored copies live in skills/, see README)
.agents/
.claude/

# secrets
.env
.env.*

# offensive / NSFW memes stay local; index entries for them are rating=nsfw and filtered out by default
skills/shipreel/assets/memes/_flagged/

# python / node / OS
__pycache__/
*.pyc
node_modules/
.DS_Store
Thumbs.db

# built locally from Buzzer.cs on first use (no binaries in the repo)
skills/shipreel/tools/buzzer/buzzer.exe

# music folder the user added (copyrighted soundtracks) and its local-only index
skills/shipreel/assets/music/meme-music/
skills/shipreel/assets/index.local.json
